  "entrypoints": {
    "client": ["pl.life.visuals.LifeVisualsClient"]
  },
  "mixins": ["lifevisuals.mixins.json", "lifevisuals.extra.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
